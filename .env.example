# Vision — local Docker Compose environment (example)
#
# Copy this file to `.env` and fill in values only if you want to exercise
# real Cognito login or a real OTLP telemetry collector against the
# containerized stack. `.env` is git-ignored and must never be committed.
#
# None of these are required for `docker compose up --build` to work: the
# stack starts and the backends stay in their existing fail-closed
# authentication state (401 on protected endpoints) when Cognito values are
# omitted, and telemetry export is a no-op when no OTLP endpoint is set.

# --- Cognito (backend) --------------------------------------------------
# A Cognito User Pool ID / region / app client ID are not secrets — they are
# public identifiers. Do not put a Cognito app client SECRET here; Vision's
# browser client is a public client and must not have one.
COGNITO_USER_POOL_ID=
COGNITO_REGION=us-east-1
COGNITO_CLIENT_ID=

# --- Cognito (frontend, browser-public) ----------------------------------
# These are inlined into the frontend's built JavaScript bundle at
# `docker compose build` time (see src/frontend/Dockerfile). Changing them
# requires rebuilding the frontend image, not just restarting the container.
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback
NEXT_PUBLIC_COGNITO_LOGOUT_URI=http://localhost:3000

# --- OpenTelemetry OTLP exporter (optional) ------------------------------
# Leave blank for local Compose — the stack does not require a telemetry
# collector. If set, use your own collector/vendor endpoint; never commit a
# real authorization header.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# --- LocalStack (optional) ------------------------------------------------
# Only needed if you have a LocalStack Pro auth token. Leave blank for the
# free/community LocalStack image used by this Compose file.
LOCALSTACK_AUTH_TOKEN=
