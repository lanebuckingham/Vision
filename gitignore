# ------------------------------------------------------------
# Terraform / Infrastructure
# ------------------------------------------------------------
.terraform/
.terraform.lock.hcl.backup

# Terraform state contains sensitive infrastructure data
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Variable files frequently contain secrets
*.tfvars
*.tfvars.json

# Allow safe examples/templates
!*.tfvars.example
!*.tfvars.sample
!*.tfvars.template

# Terraform override files are normally local
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan files
*.tfplan
tfplan

# ------------------------------------------------------------
# Docker / local containers
# ------------------------------------------------------------
docker-compose.override.yml
docker-compose.override.yaml

# Local volumes/data if created inside repository
docker-data/
volumes/
postgres-data/
pgdata/

