# ============================================================
# Vision - .gitignore
# .NET + Next.js + Terraform + Azure/AWS + PostgreSQL/Neon
# ============================================================

# ------------------------------------------------------------
# Environment variables and local secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
!.env.template

*.env
*.env.local

# Generic secret/config files
secrets.json
secrets.*.json
*.secrets.json
*.secret
*.secrets

# Local-only application settings
appsettings.Local.json
appsettings.*.Local.json
appsettings.local.json
appsettings.*.local.json

# Optional: keep machine-specific development settings out of Git.
# If appsettings.Development.json is intentionally source-controlled,
# leave it tracked and put secrets in environment variables / user-secrets.
appsettings.Development.local.json

# Certificates, keys, credentials
*.pfx
*.p12
*.pem
*.key
*.crt
*.cer
*.jks
*.keystore

# SSH / credential material
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# AWS local credentials/config if ever copied into the repo
.aws/
aws-credentials
credentials.aws

# Azure local/auth artifacts
.azure/

